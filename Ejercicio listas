# Lista anidada: [nombre, precio]
carrito = [
    ["Arroz", 2.50],
    ["Leche", 1.20],
    ["Pan", 3.00]
]

total = 0
for producto in carrito:
    total += producto[1] # Sumamos el segundo elemento de cada sublista (el precio)

print(f"Total de la compra: ${total:.2f}")
