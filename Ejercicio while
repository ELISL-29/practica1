Ejercicio práctico
Adivina el número
import random

secreto = random.randint(1, 100)
intentos = 0

print("Adivina el número entre 1 y 100")

while True:
    numero = int(input("Tu número: "))
    intentos += 1

    if numero < secreto:
        print("Muy bajo")
    elif numero > secreto:
        print("Muy alto")
    else:
        print(f"¡Correcto en {intentos} intentos!")
        break
