*Ejemplo real: búsqueda con break
estudiantes = ["Ana", "Luis", "Sara", "Pedro"]
buscar = input("¿A quién buscas? ")

for i, nombre in enumerate(estudiantes):
    if nombre == buscar:
        print(f"Encontrado en posición {i}")
        break
else: # se ejecuta si el for terminó sin break
    print("No encontrado")

Versión tradicional vs. comprensión
# Tradicional
cuadrados = []
for n in range(1, 6):
    cuadrados.append(n ** 2)
# [1, 4, 9, 16, 25]

# Con comprensión — una línea
cuadrados = [n ** 2 for n in range(1, 6)]
# [1, 4, 9, 16, 25]
