Ejemplo Completo: Análisis de Notas
# Recopilar notas de 5 estudiantes
notas = []

for i in range(1, 6):
    nota = float(input(f"Nota estudiante {i}: "))
    notas.append(nota)

# Analizar
total = 0
aprobados = 0
reprobados = 0

for i, nota in enumerate(notas, start=1):
    total += nota
    if nota >= 60:
        aprobados += 1
    else:
        reprobados += 1
promedio = total / len(notas)

# Mostrar reporte
print("=== Reporte del Grupo ===")
print(f"Promedio: {promedio:.2f}")
print(f"Aprobados: {aprobados}")
print(f"Reprobados: {reprobados}")
print(f"Mejor nota: {max(notas)}")
print(f"Peor nota: {min(notas)}")

# Listar quiénes reprobaron
print("--- Notas reprobadas ---")
for i, nota in enumerate(notas, start=1):
    if nota < 60:
        print(f" Estudiante {i}: {nota}")

